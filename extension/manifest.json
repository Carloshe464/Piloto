{
  "manifest_version": 3,
  "name": "Piloto — Ponte Zendesk",
  "version": "0.1.0",
  "description": "Lê metadados da ligação no DOM do Zendesk e envia ao app Piloto via WebSocket local (127.0.0.1).",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "*://*.zendesk.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.zendesk.com/*"],
      "js": ["content-zendesk.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Piloto — Ponte Zendesk"
  }
}
