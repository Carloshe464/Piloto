<Window x:Class="Piloto.App.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhe da ligação"
        Height="720" Width="820"
        MinHeight="520" MinWidth="640"
        Background="{StaticResource Fundo}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtCabecalho" FontSize="19" FontWeight="Bold" Text="Ligação" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Data" FontSize="11" Foreground="{StaticResource TextoApagado}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtChipData" FontSize="12" Foreground="{StaticResource Texto}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Número" FontSize="11" Foreground="{StaticResource TextoApagado}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtChipNumero" FontSize="12" Foreground="{StaticResource Texto}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ticket" FontSize="11" Foreground="{StaticResource TextoApagado}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtChipTicket" FontSize="12" Foreground="{StaticResource Texto}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Duração" FontSize="11" Foreground="{StaticResource TextoApagado}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtChipDuracao" FontSize="12" Foreground="{StaticResource Texto}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Banner de revisão -->
        <Border x:Name="PanelRevisao" Grid.Row="1" Background="{StaticResource AlertaFundo}"
                BorderBrush="#92600A" BorderThickness="1" CornerRadius="8"
                Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Foreground="{StaticResource Alerta}" FontSize="14"
                           Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock x:Name="TxtRevisao" Foreground="{StaticResource AlertaClaro}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Abas -->
        <TabControl Grid.Row="2">

            <TabItem Header="Resumo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="RESUMO DA CONVERSA" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                                <TextBlock x:Name="TxtResumo" FontSize="14" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Border Style="{StaticResource Chip}" Background="{StaticResource AcentoFundo}"
                                            BorderBrush="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Motivo" FontSize="11" Foreground="{StaticResource TextoFraco}"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtMotivo" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AcentoClaro}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Background="{StaticResource AcentoFundo}"
                                            BorderBrush="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Produto" FontSize="11" Foreground="{StaticResource TextoFraco}"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtProduto" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AcentoClaro}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Background="{StaticResource SucessoFundo}"
                                            BorderBrush="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Status" FontSize="11" Foreground="{StaticResource TextoFraco}"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtStatus" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SucessoClaro}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="PEDIDO DO CLIENTE" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TxtPedido" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PRÓXIMO PASSO" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TxtProximo" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diálogo">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Conversa na ordem do tempo — atendente à esquerda, cliente à direita"
                                   FontSize="11.5" Foreground="{StaticResource TextoFraco}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="BtnCopiarDialogo" Content="Copiar diálogo" Click="CopiarDialogo_Click"
                                DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0"
                                Padding="10,5" FontSize="12" />
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <ItemsControl x:Name="ListaDialogo">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border MaxWidth="540" CornerRadius="10" Padding="11,8" Margin="0,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SucessoFundo}" />
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EhAtendente}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AcentoFundo}" />
                                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding Rotulo}" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource SucessoClaro}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EhAtendente}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource AcentoClaro}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Horario}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextoApagado}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" FontSize="13" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TxtDialogoVazio" Text="Nenhuma fala transcrita nesta ligação."
                                           Foreground="{StaticResource TextoFraco}" Visibility="Collapsed"
                                           HorizontalAlignment="Center" Margin="0,24" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Dados extraídos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="CAMPOS OBJETIVOS (CAMADA DE REGRAS)"
                                       Style="{StaticResource Rotulo}" Margin="0,0,0,8" />
                            <TextBlock x:Name="TxtCampos" FontFamily="Consolas" FontSize="12.5"
                                       LineHeight="20" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Barra de exportação -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <CheckBox x:Name="ChkMascarar" Content="Mascarar PII" IsChecked="True" Margin="0,0,16,0" />
            <Button Content="Exportar TXT" Click="ExportarTxt_Click" />
            <Button Content="Exportar JSON" Click="ExportarJson_Click" />
            <Button Content="Exportar CSV" Click="ExportarCsv_Click" />
            <Button Content="Fechar" Click="Fechar_Click" Style="{StaticResource BotaoPrimario}"
                    DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0" MinWidth="100" />
        </DockPanel>
    </Grid>
</Window>
