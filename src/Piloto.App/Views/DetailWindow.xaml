<Window x:Class="Piloto.App.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhe da ligação"
        Height="760" Width="980"
        MinHeight="620" MinWidth="760"
        Icon="../Assets/click-write.ico"
        Background="{DynamicResource Fundo}"
        FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Image Width="48" Height="48" Source="../Assets/click-write-icon.png"
                       Stretch="Uniform" AutomationProperties.Name="Logotipo Click Write" />
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCabecalho" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource Texto}" Text="Ligação" />
                    <TextBlock Text="Transcrição, resumo e dados extraídos"
                               Foreground="{DynamicResource TextoFraco}" FontSize="12.5" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Data" FontSize="11" Foreground="{StaticResource TextoApagado}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtChipData" FontSize="12" Foreground="{StaticResource Texto}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Número" FontSize="11" Foreground="{StaticResource TextoApagado}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtChipNumero" FontSize="12" Foreground="{StaticResource Texto}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ticket" FontSize="11" Foreground="{StaticResource TextoApagado}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtChipTicket" FontSize="12" Foreground="{StaticResource Texto}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Duração" FontSize="11" Foreground="{StaticResource TextoApagado}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtChipDuracao" FontSize="12" Foreground="{StaticResource Texto}" />
                    </StackPanel>
                </Border>
                <Border x:Name="ChipCliente" Style="{StaticResource Chip}" Visibility="Collapsed"
                        Background="{StaticResource SucessoFundo}" BorderBrush="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cliente" FontSize="11" Foreground="{StaticResource TextoFraco}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtChipCliente" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SucessoClaro}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Banner de revisão -->
        <Border x:Name="PanelRevisao" Grid.Row="1" Background="{DynamicResource AlertaFundo}"
                BorderBrush="{DynamicResource Alerta}" BorderThickness="1.5" CornerRadius="8"
                Padding="14,11" Margin="0,0,0,14" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Foreground="{DynamicResource Alerta}" FontSize="17"
                           Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock x:Name="TxtRevisao" Foreground="{DynamicResource Texto}"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Abas -->
        <TabControl Grid.Row="2">

            <TabItem Header="Resumo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="RESUMO DA CONVERSA" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                                <TextBlock x:Name="TxtResumo" FontSize="14" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Border Style="{StaticResource Chip}" Background="{StaticResource AcentoFundo}"
                                            BorderBrush="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Motivo" FontSize="11" Foreground="{StaticResource TextoFraco}"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtMotivo" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AcentoClaro}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Background="{StaticResource AcentoFundo}"
                                            BorderBrush="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Produto" FontSize="11" Foreground="{StaticResource TextoFraco}"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtProduto" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AcentoClaro}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Background="{StaticResource SucessoFundo}"
                                            BorderBrush="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Status" FontSize="11" Foreground="{StaticResource TextoFraco}"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtStatus" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SucessoClaro}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Cor definida em código: verde satisfeito, âmbar com dúvidas,
                                         vermelho triste. Fica oculto quando o servidor não conseguiu
                                         classificar — chip vazio não informa nada. -->
                                    <Border x:Name="ChipSatisfacao" Style="{StaticResource Chip}"
                                            Background="{StaticResource AcentoFundo}" BorderBrush="Transparent"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Satisfação" FontSize="11" Foreground="{StaticResource TextoFraco}"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtSatisfacao" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AcentoClaro}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="PEDIDO DO CLIENTE" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TxtPedido" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PRÓXIMO PASSO" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TxtProximo" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diálogo">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Conversa na ordem do tempo — atendente à esquerda, cliente à direita"
                                   FontSize="11.5" Foreground="{StaticResource TextoFraco}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="BtnCopiarDialogo" Content="Copiar diálogo" Click="CopiarDialogo_Click"
                                DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0"
                                Padding="10,5" FontSize="12" />
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <ItemsControl x:Name="ListaDialogo">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border MaxWidth="540" CornerRadius="10" Padding="11,8" Margin="0,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SucessoFundo}" />
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EhAtendente}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AcentoFundo}" />
                                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding Rotulo}" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource SucessoClaro}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EhAtendente}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource AcentoClaro}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Horario}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextoApagado}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" FontSize="13" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TxtDialogoVazio" Text="Nenhuma fala transcrita nesta ligação."
                                           Foreground="{StaticResource TextoFraco}" Visibility="Collapsed"
                                           HorizontalAlignment="Center" Margin="0,24" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Dados extraídos">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                               FontSize="11.5" Foreground="{StaticResource TextoFraco}"
                               Text="Valores exibidos sem máscara para cópia no cadastro. &quot;Cadastro&quot; vem do Zendesk e é confiável; os demais foram ouvidos na ligação — confira os de confiança baixa no áudio." />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListaCampos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titulo}" Style="{StaticResource Rotulo}"
                                                       Margin="0,0,0,8" />

                                            <TextBlock Text="Não identificado" FontSize="13"
                                                       Foreground="{StaticResource TextoApagado}"
                                                       Visibility="{Binding VisibilidadeVazio}" />

                                            <ItemsControl ItemsSource="{Binding Valores}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBox Text="{Binding Valor, Mode=OneWay}"
                                                                             IsReadOnly="True" BorderThickness="0"
                                                                             Background="Transparent" Padding="0"
                                                                             FontFamily="Consolas" FontSize="14"
                                                                             Foreground="{StaticResource Texto}"
                                                                             VerticalAlignment="Center" />
                                                                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                                            Background="{Binding FundoOrigem}"
                                                                            BorderBrush="Transparent">
                                                                        <TextBlock Text="{Binding RotuloOrigem}" FontSize="10.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{Binding CorOrigem}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Procedencia}" FontSize="11"
                                                                           Foreground="{StaticResource TextoApagado}"
                                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            </StackPanel>

                                                            <Button Grid.Column="1" Content="Copiar" Tag="{Binding Valor}"
                                                                    Click="CopiarCampo_Click" Padding="10,4" FontSize="11.5"
                                                                    Margin="10,0,0,0" VerticalAlignment="Top" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Barra de exportação -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Divisor}" BorderThickness="0,1,0,0"
                Margin="0,16,0,0" Padding="0,14,0,0">
            <DockPanel>
                <CheckBox x:Name="ChkMascarar" Content="Mascarar PII" IsChecked="True"
                          Margin="0,0,18,0" VerticalAlignment="Center" />
                <Button Content="Exportar TXT" Click="ExportarTxt_Click" />
                <Button Content="Exportar JSON" Click="ExportarJson_Click" />
                <Button Content="Exportar CSV" Click="ExportarCsv_Click" />
                <Button Content="↻ Reprocessar no servidor" Click="Reprocessar_Click"
                        ToolTip="Solicita ao servidor uma nova transcrição e substitui o resultado atual" />
                <Button Content="Fechar" Click="Fechar_Click" Style="{StaticResource BotaoPrimario}"
                        DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0" MinWidth="112" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
