<Window x:Class="Piloto.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações do Click Write"
        Height="720" Width="720"
        Background="{StaticResource Fundo}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="MODELOS DE IA" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                <TextBlock x:Name="TxtStatusModelos" TextWrapping="Wrap" />
                <Button Content="Abrir pasta de modelos" Click="AbrirPastaModelos_Click"
                        HorizontalAlignment="Left" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Listas fechadas — motivo do contato (um por linha)" Style="{StaticResource Rotulo}" />
                <TextBox x:Name="TxtMotivos" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />

                <TextBlock Text="Listas fechadas — produto (um por linha)" Style="{StaticResource Rotulo}" />
                <TextBox x:Name="TxtProdutos" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />

                <TextBlock Text="Listas fechadas — status (um por linha)" Style="{StaticResource Rotulo}" />
                <TextBox x:Name="TxtStatus" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />

                <TextBlock Text="Glossário (initial_prompt do Whisper)" Style="{StaticResource Rotulo}" />
                <TextBox x:Name="TxtGlossario" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Retenção áudio (dias)" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="TxtRetAudio" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Retenção transcrição (dias)" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="TxtRetTransc" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Porta do bridge" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="TxtPorta" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Modelo Whisper (arquivo)" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="TxtWhisperModelo" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Whisper threads" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="TxtWhisperThreads" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ChkLlm" Content="Habilitar camada LLM (resumo)" Margin="0,14,0,0" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Modelo LLM (arquivo)" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="TxtLlmModelo" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="LLM threads" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="TxtLlmThreads" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Temperatura" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="TxtLlmTemp" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Alterações de porta e de modelo passam a valer no próximo início do app."
                           Foreground="{StaticResource TextoFraco}" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="Salvar" Click="Salvar_Click" Style="{StaticResource BotaoPrimario}" MinWidth="110" />
            <Button Content="Cancelar" Click="Cancelar_Click" />
        </DockPanel>
    </Grid>
</Window>
