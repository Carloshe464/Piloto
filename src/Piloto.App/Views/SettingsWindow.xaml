<Window x:Class="Piloto.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações do Click Write"
        Height="760" Width="820"
        MinHeight="620" MinWidth="700"
        Icon="../Assets/click-write.ico"
        Background="{DynamicResource Fundo}"
        FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AcentoClaro}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="52" Height="52" Source="../Assets/click-write-icon.png"
                   Stretch="Uniform" AutomationProperties.Name="Logotipo Click Write" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Configurações" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource Texto}" />
                <TextBlock Text="Conexão, bridge e listas de classificação"
                           Foreground="{DynamicResource TextoFraco}" FontSize="13" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Servidor e bridge">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,2,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="STATUS DO SERVIDOR" Style="{StaticResource SectionCaption}" />
                                    <TextBlock x:Name="TxtStatusModelos" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Texto}" LineHeight="21" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                    <Button Content="Testar conexão" Click="TestarConexao_Click" />
                                    <Button Content="Abrir pasta de dados" Click="AbrirPastaModelos_Click" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CONEXÃO" Style="{StaticResource SectionCaption}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.4*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Endereço do servidor de transcrição" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TxtServidorUrl" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Porta do bridge" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TxtPorta" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Token deste atendente" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" />
                                <TextBox x:Name="TxtServidorToken" />
                                <TextBlock Text="O token identifica esta máquina no servidor e pode ser substituído quando um novo acesso for emitido. Alterações da porta bridge passam a valer no próximo início."
                                           Foreground="{DynamicResource TextoFraco}" FontSize="12"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Listas fechadas">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,2,8,0">
                    <StackPanel>
                        <TextBlock Text="Um valor por linha. Estas listas orientam a classificação devolvida pelo servidor."
                                   Foreground="{DynamicResource TextoFraco}" FontSize="12.5"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Motivo do contato" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TxtMotivos" AcceptsReturn="True" Height="118"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Produto" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TxtProdutos" AcceptsReturn="True" Height="118"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TxtStatus" AcceptsReturn="True" Height="118"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Divisor}" BorderThickness="0,1,0,0"
                Margin="0,16,0,0" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancelar_Click" MinWidth="112" />
                <Button Content="Salvar alterações" Click="Salvar_Click"
                        Style="{StaticResource BotaoPrimario}" MinWidth="150" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
