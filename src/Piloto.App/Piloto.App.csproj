<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Piloto.App</RootNamespace>
    <!-- Nome comercial no executável. Os namespaces e nomes de projeto continuam
         Piloto.* de propósito: renomeá-los seria churn em todo o repositório sem
         nenhum efeito para quem usa o app. -->
    <AssemblyName>ClickWrite</AssemblyName>
  </PropertyGroup>

  <!-- O SDK de WPF não inclui System.IO nos usings implícitos; adiciona globalmente. -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Piloto.Core\Piloto.Core.csproj" />
    <ProjectReference Include="..\Piloto.Rules\Piloto.Rules.csproj" />
    <ProjectReference Include="..\Piloto.Data\Piloto.Data.csproj" />
    <ProjectReference Include="..\Piloto.Audio\Piloto.Audio.csproj" />
    <ProjectReference Include="..\Piloto.Transcription\Piloto.Transcription.csproj" />
    <ProjectReference Include="..\Piloto.Llm\Piloto.Llm.csproj" />
    <ProjectReference Include="..\Piloto.Bridge\Piloto.Bridge.csproj" />
  </ItemGroup>

  <!-- Config padrão empacotada; semeada em %LOCALAPPDATA%\Piloto\config na 1ª execução -->
  <ItemGroup>
    <Content Include="..\..\config\appsettings.json" Link="config\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\config\listas.json" Link="config\listas.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\config\glossario.txt" Link="config\glossario.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- O publish com RID achata os assets nativos do NuGet na raiz, o que colide as variantes
       avx/avx2/avx512/noavx do LLamaSharp.Backend.Cpu (NETSDK1152) e remove as subpastas
       runtimes\win-x64\native\<variante>\ que o loader do LLamaSharp procura em runtime.
       Este target devolve cada DLL do backend ao seu caminho original dentro do publish. -->
  <Target Name="PreservarNativosLLamaSharpNoPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_LLamaNativoAchatado Include="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'LLamaSharp.Backend.Cpu'" />
      <ResolvedFileToPublish Remove="@(_LLamaNativoAchatado)" />
      <ResolvedFileToPublish Include="@(_LLamaNativoAchatado)">
        <RelativePath>$([System.Text.RegularExpressions.Regex]::Replace('%(_LLamaNativoAchatado.Identity)', '^.*[\\/]runtimes[\\/]', 'runtimes/'))</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
