<Application x:Class="Piloto.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- ============================ Paleta ============================ -->
        <SolidColorBrush x:Key="Fundo" Color="#0F172A" />
        <SolidColorBrush x:Key="Painel" Color="#1E293B" />
        <SolidColorBrush x:Key="PainelAlto" Color="#263449" />
        <SolidColorBrush x:Key="Entrada" Color="#111C30" />
        <SolidColorBrush x:Key="Borda" Color="#334155" />
        <SolidColorBrush x:Key="BordaClara" Color="#4B607C" />
        <SolidColorBrush x:Key="Texto" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextoFraco" Color="#A8B5C7" />
        <SolidColorBrush x:Key="TextoApagado" Color="#66758B" />
        <SolidColorBrush x:Key="Acento" Color="#06B6D4" />
        <SolidColorBrush x:Key="AcentoClaro" Color="#67E8F9" />
        <SolidColorBrush x:Key="AcentoFundo" Color="#123A49" />
        <SolidColorBrush x:Key="BotaoFundo" Color="#08111F" />
        <SolidColorBrush x:Key="TabelaCabecalho" Color="#192438" />
        <SolidColorBrush x:Key="Divisor" Color="#34435A" />
        <SolidColorBrush x:Key="LinhaHover" Color="#26364C" />
        <SolidColorBrush x:Key="LinhaSelecionada" Color="#244B5D" />
        <SolidColorBrush x:Key="BarraRolagem" Color="#6B7C93" />
        <SolidColorBrush x:Key="RecFundo" Color="#294E58" />
        <SolidColorBrush x:Key="StopFundo" Color="#334155" />
        <SolidColorBrush x:Key="PillAzulFundo" Color="#13283D" />
        <SolidColorBrush x:Key="PillVerdeFundo" Color="#10291E" />
        <SolidColorBrush x:Key="PillAmbarFundo" Color="#3A2A08" />
        <SolidColorBrush x:Key="PillRoxoFundo" Color="#2A1D3A" />
        <SolidColorBrush x:Key="Sucesso" Color="#34D399" />
        <SolidColorBrush x:Key="SucessoClaro" Color="#6EE7B7" />
        <SolidColorBrush x:Key="SucessoFundo" Color="#10291E" />
        <SolidColorBrush x:Key="Alerta" Color="#FBBF24" />
        <SolidColorBrush x:Key="AlertaClaro" Color="#FDE68A" />
        <SolidColorBrush x:Key="AlertaFundo" Color="#3A2A08" />
        <SolidColorBrush x:Key="Perigo" Color="#F87171" />
        <SolidColorBrush x:Key="PerigoClaro" Color="#FCA5A5" />
        <SolidColorBrush x:Key="PerigoFundo" Color="#2A1420" />

        <!-- ========================= Tipografia =========================== -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
        </Style>

        <!-- Rótulo de seção (versalete visual: pequeno, fraco, seminegrito) -->
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <!-- =========================== Botões ============================= -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PainelAlto}" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AcentoFundo}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Acento}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PainelAlto}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ação principal (destaque em acento) -->
        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Acento}" />
            <Setter Property="Foreground" Value="{DynamicResource Fundo}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AcentoClaro}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AA5DB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ação de gravação (vermelho contido) -->
        <Style x:Key="BotaoGravacao" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PerigoFundo}" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#7F1D1D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PerigoFundo}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Perigo}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PainelAlto}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================== Entradas ============================ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Entrada}" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{DynamicResource Acento}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Acento}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BordaClara}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Acento}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- ====================== Cartões e chips ========================= -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Painel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Entrada}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ====================== Lista (histórico) ======================= -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="4,7">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PainelAlto}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AcentoFundo}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="Transparent" BorderBrush="{DynamicResource Borda}"
                                BorderThickness="0,0,0,1" Padding="6,4,6,8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Abas ============================== -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True"
                                      Margin="0,0,0,12" Background="Transparent" />
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Padding="14,8" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AcentoFundo}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PainelAlto}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AcentoClaro}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
