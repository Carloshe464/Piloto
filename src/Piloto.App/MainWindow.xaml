<Window x:Class="Piloto.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piloto — Transcrição Local de Ligações"
        Height="640" Width="1040"
        MinHeight="480" MinWidth="820"
        Background="{StaticResource Fundo}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Painel}" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Banner modelos ausentes -->
        <Border x:Name="BannerModelos" Grid.Row="0" Background="#78350f" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="TxtBanner" TextWrapping="Wrap" Foreground="#fde68a"
                       Text="Modelos ausentes — a fila está pausada." />
        </Border>

        <!-- Barra de ações -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button x:Name="BtnGravar" Content="● Iniciar gravação" Click="BtnGravar_Click"
                    Foreground="#fca5a5" FontWeight="SemiBold" />
            <Button x:Name="BtnNaoGravar" Content="Não gravar esta chamada" Click="BtnNaoGravar_Click"
                    IsEnabled="False" />
            <Button Content="Configurações…" Click="BtnConfig_Click" DockPanel.Dock="Right" Margin="0" />
            <Button Content="Atualizar" Click="BtnAtualizar_Click" DockPanel.Dock="Right" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox x:Name="TxtBusca" Width="240" VerticalContentAlignment="Center"
                         Background="{StaticResource Painel}" Foreground="{StaticResource Texto}"
                         BorderBrush="#334155" Padding="6,4" Margin="0,0,8,0"
                         KeyDown="TxtBusca_KeyDown" />
                <Button Content="Buscar" Click="BtnBuscar_Click" />
            </StackPanel>
        </DockPanel>

        <!-- Contadores -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTotal" Margin="0,0,24,0" Foreground="{StaticResource TextoFraco}" Text="Chamadas: 0" />
            <TextBlock x:Name="TxtTempo" Margin="0,0,24,0" Foreground="{StaticResource TextoFraco}" Text="Tempo falado: 00:00:00" />
            <TextBlock x:Name="TxtRevisao" Margin="0,0,24,0" Foreground="{StaticResource Alerta}" Text="A revisar: 0" />
            <TextBlock x:Name="TxtFila" Foreground="{StaticResource Acento}" Text="Fila: 0" />
        </StackPanel>

        <!-- Histórico -->
        <ListView x:Name="ListaChamadas" Grid.Row="3"
                  Background="{StaticResource Painel}" Foreground="{StaticResource Texto}"
                  BorderBrush="#334155"
                  MouseDoubleClick="Lista_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Data" Width="130" DisplayMemberBinding="{Binding Data}" />
                    <GridViewColumn Header="Número" Width="130" DisplayMemberBinding="{Binding Numero}" />
                    <GridViewColumn Header="Motivo" Width="200" DisplayMemberBinding="{Binding Motivo}" />
                    <GridViewColumn Header="Produto" Width="160" DisplayMemberBinding="{Binding Produto}" />
                    <GridViewColumn Header="Status" Width="180" DisplayMemberBinding="{Binding Status}" />
                    <GridViewColumn Header="Duração" Width="90" DisplayMemberBinding="{Binding Duracao}" />
                    <GridViewColumn Header="!" Width="30" DisplayMemberBinding="{Binding Revisao}" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="TxtStatus" Grid.Row="4" Margin="0,10,0,0"
                   Foreground="{StaticResource TextoFraco}" Text="Pronto." />
    </Grid>
</Window>
