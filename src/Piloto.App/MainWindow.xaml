<Window x:Class="Piloto.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Click Write — Transcrição Local de Ligações"
        Height="680" Width="1080"
        MinHeight="500" MinWidth="860"
        Background="{StaticResource Fundo}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho: identidade + ações de janela -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Border Background="{StaticResource AcentoFundo}" CornerRadius="8"
                        Width="38" Height="38" VerticalAlignment="Center">
                    <TextBlock Text="P" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource AcentoClaro}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Click Write" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Transcrição e resumo de ligações — 100% local"
                               FontSize="11.5" Foreground="{StaticResource TextoFraco}" />
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="Atualizar" Click="BtnAtualizar_Click" />
                <Button Content="Configurações" Click="BtnConfig_Click" Margin="0" />
            </StackPanel>
        </DockPanel>

        <!-- Banner de avisos: servidor de transcrição fora do ar, contrato incompatível,
             modelo de resumo ausente. Texto preenchido em MainWindow.AtualizarBanner(). -->
        <Border x:Name="BannerModelos" Grid.Row="1" Background="{StaticResource AlertaFundo}"
                BorderBrush="#92600A" BorderThickness="1" CornerRadius="8"
                Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Foreground="{StaticResource Alerta}" FontSize="14"
                           Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock x:Name="TxtBanner" TextWrapping="Wrap" Foreground="{StaticResource AlertaClaro}"
                           Text="Verificando o servidor de transcrição…" />
            </StackPanel>
        </Border>

        <!-- Barra de ações -->
        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <Button x:Name="BtnGravar" Content="● Iniciar gravação" Click="BtnGravar_Click"
                    Style="{StaticResource BotaoGravacao}" MinWidth="180" />
            <Button x:Name="BtnNaoGravar" Content="Não gravar esta chamada" Click="BtnNaoGravar_Click"
                    IsEnabled="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBox x:Name="TxtBusca" Width="270" KeyDown="TxtBusca_KeyDown" />
                    <TextBlock Text="Buscar número, motivo, produto…"
                               IsHitTestVisible="False" Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextoApagado}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtBusca}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Content="Buscar" Click="BtnBuscar_Click" Margin="0" />
            </StackPanel>
        </DockPanel>

        <!-- Métricas -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Style="{StaticResource Chip}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Acento}"
                             VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="TxtTotal" Text="Chamadas: 0" FontSize="12"
                               Foreground="{StaticResource TextoFraco}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Chip}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Sucesso}"
                             VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="TxtTempo" Text="Tempo falado: 00:00:00" FontSize="12"
                               Foreground="{StaticResource TextoFraco}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Chip}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Alerta}"
                             VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="TxtRevisao" Text="A revisar: 0" FontSize="12"
                               Foreground="{StaticResource TextoFraco}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Chip}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AcentoClaro}"
                             VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="TxtFila" Text="Fila: 0" FontSize="12"
                               Foreground="{StaticResource TextoFraco}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Histórico -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10">
            <ListView x:Name="ListaChamadas" MouseDoubleClick="Lista_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="DATA" Width="135" DisplayMemberBinding="{Binding Data}" />
                        <GridViewColumn Header="NÚMERO" Width="130" DisplayMemberBinding="{Binding Numero}" />
                        <GridViewColumn Header="MOTIVO" Width="210" DisplayMemberBinding="{Binding Motivo}" />
                        <GridViewColumn Header="PRODUTO" Width="170" DisplayMemberBinding="{Binding Produto}" />
                        <GridViewColumn Header="STATUS" Width="180" DisplayMemberBinding="{Binding Status}" />
                        <GridViewColumn Header="DURAÇÃO" Width="90" DisplayMemberBinding="{Binding Duracao}" />
                        <GridViewColumn Header="" Width="36">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Revisao}" Foreground="{StaticResource Alerta}"
                                               FontSize="13" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock x:Name="TxtStatus" Grid.Row="5" Margin="2,10,0,0" FontSize="12"
                   Foreground="{StaticResource TextoFraco}" Text="Pronto." />
    </Grid>
</Window>
