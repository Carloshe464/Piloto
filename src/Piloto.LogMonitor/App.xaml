<Application x:Class="Piloto.LogMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Fundo" Color="#E8E4DC" />
        <SolidColorBrush x:Key="Painel" Color="#F4F1EA" />
        <SolidColorBrush x:Key="PainelAlto" Color="#DDD8CF" />
        <SolidColorBrush x:Key="Texto" Color="#202A2E" />
        <SolidColorBrush x:Key="TextoFraco" Color="#546268" />
        <SolidColorBrush x:Key="Borda" Color="#A9A298" />
        <SolidColorBrush x:Key="Acento" Color="#087D89" />
        <SolidColorBrush x:Key="AcentoFundo" Color="#B9E0E1" />
        <SolidColorBrush x:Key="Erro" Color="#B42332" />
        <SolidColorBrush x:Key="Alerta" Color="#B66A00" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="#D1E8E8" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="{StaticResource Painel}" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borda}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="{StaticResource Painel}" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borda}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource PainelAlto}" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource Borda}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="BorderBrush" Value="#C8C2B8" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="{StaticResource Painel}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCE9E7" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AcentoFundo}" /></Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
