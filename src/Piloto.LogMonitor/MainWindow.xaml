<Window x:Class="Piloto.LogMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Click Write - Monitor de Atividades" Width="1180" Height="760"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        Icon="Assets/click-write.ico" Background="{StaticResource Fundo}"
        Foreground="{StaticResource Texto}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/click-write-icon.png" Width="54" Height="54" Stretch="Uniform" />
                <StackPanel Margin="12,4,0,0">
                    <TextBlock Text="Click Write" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Texto}" />
                    <TextBlock Text="Monitor de atividades do aplicativo" Foreground="{StaticResource TextoFraco}" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource AcentoFundo}" BorderBrush="{StaticResource Acento}"
                    BorderThickness="1" CornerRadius="6" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="#16834A" Margin="0,0,8,0" />
                    <TextBlock Text="Atualização automática" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="-4,0,-4,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="FiltroNivel" Width="150" SelectionChanged="Filtro_Changed">
                <ComboBoxItem Content="Todos os níveis" IsSelected="True" />
                <ComboBoxItem Content="Information" />
                <ComboBoxItem Content="Warning" />
                <ComboBoxItem Content="Error" />
            </ComboBox>
            <ComboBox x:Name="FiltroModulo" Grid.Column="1" Width="180" SelectionChanged="Filtro_Changed" />
            <TextBox x:Name="Busca" Grid.Column="2" TextChanged="Busca_TextChanged" ToolTip="Buscar na descrição ou nos detalhes" />
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Content="Atualizar" Click="Atualizar_Click" />
                <Button Content="Abrir pasta" Click="AbrirPasta_Click" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="2" x:Name="Abas" Background="{StaticResource Painel}" BorderBrush="{StaticResource Borda}">
            <TabItem Header="Eventos">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DataGrid x:Name="TabelaEventos" ItemsSource="{Binding EventosVisiveis}" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" SelectionChanged="Evento_Selecionado"
                              GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="HORA" Binding="{Binding Hora}" Width="100" />
                            <DataGridTextColumn Header="MÓDULO" Binding="{Binding Modulo}" Width="190" />
                            <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="130" />
                            <DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Descricao}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="{StaticResource Borda}" />
                    <Border Grid.Row="2" Background="#E1DDD5" BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="TituloDetalhe" Text="Detalhes do evento selecionado" FontWeight="SemiBold" />
                            <TextBox x:Name="DetalheEvento" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" Background="#EEEAE2" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Estatísticas">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#C9E1E5" Padding="20" Margin="6" CornerRadius="6"><StackPanel><TextBlock Text="EVENTOS" FontWeight="Bold"/><TextBlock x:Name="TotalEventos" Text="0" FontSize="34" FontWeight="Bold"/></StackPanel></Border>
                    <Border Grid.Column="1" Background="#E7C7CA" Padding="20" Margin="6" CornerRadius="6"><StackPanel><TextBlock Text="ERROS" FontWeight="Bold"/><TextBlock x:Name="TotalErros" Text="0" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Erro}"/></StackPanel></Border>
                    <Border Grid.Column="2" Background="#E8D5AE" Padding="20" Margin="6" CornerRadius="6"><StackPanel><TextBlock Text="GRAVAÇÕES" FontWeight="Bold"/><TextBlock x:Name="TotalGravacoes" Text="0" FontSize="34" FontWeight="Bold"/></StackPanel></Border>
                    <Border Grid.Column="3" Background="#C9E3D3" Padding="20" Margin="6" CornerRadius="6"><StackPanel><TextBlock Text="ENVIOS" FontWeight="Bold"/><TextBlock x:Name="TotalEnvios" Text="0" FontSize="34" FontWeight="Bold"/></StackPanel></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Análise de erros">
                <DataGrid x:Name="TabelaErros" ItemsSource="{Binding Erros}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="None" HeadersVisibility="Column" SelectionChanged="Erro_Selecionado">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="HORA" Binding="{Binding Hora}" Width="100" />
                        <DataGridTextColumn Header="MÓDULO" Binding="{Binding Modulo}" Width="190" />
                        <DataGridTextColumn Header="DESCRIÇÃO E DETALHES" Binding="{Binding Descricao}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" Foreground="{StaticResource TextoFraco}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Limpar visualização" Click="Limpar_Click" />
                <Button Content="Exibir erros" Click="ExibirErros_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
