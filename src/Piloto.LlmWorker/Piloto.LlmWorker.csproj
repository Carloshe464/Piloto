<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Piloto.LlmWorker</RootNamespace>
    <AssemblyName>Piloto.LlmWorker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mesma versão do Piloto.Llm: 0.25.0 é a mais recente com Gemma 3 e
         Microsoft.Extensions 9.x. Sem referência a projetos do Piloto de propósito:
         o worker é um executor burro — tudo o que ele precisa chega no request JSON.
         SEM LLamaSharp.Backend.Cpu: publicar o backend num Exe com RID estoura
         NETSDK1152 (as variantes avx/avx2/noavx colidem no achatamento). Os nativos
         já estão em runtimes\win-x64\native\ na pasta do app (publicados com o
         Piloto.exe) — o worker roda dessa pasta e o LLamaSharp os acha por lá. -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
  </ItemGroup>

</Project>
