<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Piloto.Remote</RootNamespace>
    <AssemblyName>Piloto.Remote</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sem pacote de HTTP nem de JSON: System.Net.Http e System.Text.Json fazem parte
         do framework compartilhado do net8.0. O cliente do servidor não traz dependência
         nova para o instalador. -->
